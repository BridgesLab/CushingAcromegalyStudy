/*
 * Nextflow config — U-Michigan Great Lakes (SLURM)
 * ---------------------------------------------------------------------------
 * Submits each process as its own SLURM job (executor = 'slurm') so the 23
 * samples run in parallel across the cluster, each with its own walltime —
 * instead of being packed onto one node under a single allocation's clock.
 *
 * Launch the `nextflow` orchestrator itself as a *tiny* long-lived job
 * (1 core, a few GB, walltime >= total pipeline duration). It only submits
 * and monitors the child jobs; the real compute happens in those child jobs.
 * See the launch note at the bottom.
 */

process {
    executor       = 'slurm'
    queue          = 'standard'
    clusterOptions = '--account=davebrid0'

    // sensible defaults; overridden per-process below
    cpus   = 2
    memory = 8.GB
    time   = '4h'

    withName: DOWNLOAD_GENOME      { cpus = 1; memory = 4.GB;  time = '3h'  }
    withName: DOWNLOAD_BLACKLIST   { cpus = 1; memory = 2.GB;  time = '1h'  }
    withName: BUILD_BOWTIE2_INDEX  { cpus = 8; memory = 40.GB; time = '6h'  }
    withName: GENOME_SIZES         { cpus = 1; memory = 8.GB;  time = '1h'  }
    withName: CHIP_ALIGN           { cpus = 8; memory = 24.GB; time = '12h' }
    withName: CHIP_FILTER          { cpus = 4; memory = 16.GB; time = '4h'  }
    withName: MACS2_CALLPEAK       { cpus = 2; memory = 16.GB; time = '4h'  }
    withName: CONSENSUS_PEAKS      { cpus = 1; memory = 8.GB;  time = '1h'  }
    withName: LIFTOVER_PEAKS       { cpus = 1; memory = 4.GB;  time = '1h'  }
    withName: CHIP_BIGWIG          { cpus = 2; memory = 16.GB; time = '4h'  }
}

executor {
    queueSize       = 20          // up to 20 concurrent SLURM jobs
    submitRateLimit = '10/1min'   // be polite to the scheduler
}

// Provenance / debugging (literal path — interpolating params.outdir here
// confuses the config parser → "Unknown config attribute report.params.outdir")
report  { enabled = true; overwrite = true; file = 'results/pipeline_info/report.html'   }
timeline{ enabled = true; overwrite = true; file = 'results/pipeline_info/timeline.html' }
trace   { enabled = true; overwrite = true; file = 'results/pipeline_info/trace.txt'      }
