/*
 * Nextflow config — U-Michigan Great Lakes (SLURM)
 * ---------------------------------------------------------------------------
 * Mirrors ../GR-ChIPseq/nextflow.config: each process is its own SLURM job
 * (executor = 'slurm') so the Hi-C replicates download/convert in parallel.
 *
 * Hi-C-specific tools (cooler, cooltools, hicexplorer) are NOT cluster modules,
 * so they come from per-process conda environments (the `conda` directive in
 * main.nf). conda.enabled below turns that on; the first run builds the envs
 * (cached under ./work/conda thereafter). Base tools (wget, gzip, awk, sort)
 * come from the `Bioinformatics` module declared per-process in main.nf.
 *
 * Launch the `nextflow` orchestrator as a tiny long-lived job (see nextflow.slurm).
 */

conda {
    enabled    = true
    cacheDir   = "${projectDir}/work/conda"
    useMamba   = true          // faster solves; falls back to conda if mamba absent
}

process {
    executor       = 'slurm'
    queue          = 'standard'
    clusterOptions = '--account=davebrid0'

    // sensible defaults; overridden per-process below
    cpus   = 2
    memory = 8.GB
    time   = '4h'

    withName: DOWNLOAD_CHROMSIZES   { cpus = 1; memory = 2.GB;  time = '1h'  }
    withName: DOWNLOAD_HIC          { cpus = 1; memory = 4.GB;  time = '6h'  }   // ~1 GB gz over FTP
    withName: HICUP_TO_PAIRS        { cpus = 2; memory = 8.GB;  time = '4h'  }
    withName: BUILD_COOL            { cpus = 8; memory = 64.GB; time = '12h' }   // ICE balance is the heavy step
    withName: CALL_TADS_INSULATION  { cpus = 4; memory = 32.GB; time = '4h'  }
    withName: INSULATION_TO_TADS    { cpus = 1; memory = 4.GB;  time = '1h'  }
    withName: CALL_TADS_HICEXPLORER { cpus = 8; memory = 48.GB; time = '8h'  }
    withName: LIFTOVER_TADS         { cpus = 1; memory = 4.GB;  time = '1h'  }
}

executor {
    queueSize       = 12
    submitRateLimit = '10/1min'
}

// Provenance / debugging (literal path — interpolating params.outdir here
// confuses the config parser → "Unknown config attribute report.params.outdir")
report  { enabled = true; overwrite = true; file = 'results/pipeline_info/report.html'   }
timeline{ enabled = true; overwrite = true; file = 'results/pipeline_info/timeline.html' }
trace   { enabled = true; overwrite = true; file = 'results/pipeline_info/trace.txt'      }
